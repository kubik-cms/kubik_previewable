<% unless kubik_preview_captures_show_panel?(record) %>
<% else %>
  <%= turbo_stream_from kubik_preview_captures_stream_name(record) %>
  <div class="kubik-admin-fieldset kubik-preview-captures-fieldset">
    <div class="kubik-admin-fieldset__body">
      <div id="<%= kubik_preview_captures_dom_id(record) %>"
           class="kubik-interface-tabbed kubik-preview-captures"
           data-controller="kubik-interface-tabbed">
        <div id="<%= kubik_preview_captures_inner_dom_id(record) %>">
          <%= render partial: "kubik_previewable/admin/preview_captures_inner", locals: { record: record } %>
        </div>
      </div>
    </div>
  </div>
<% end %>
